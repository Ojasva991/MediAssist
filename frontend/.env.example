# Copy to .env and adjust if pointing at a local backend during development
VITE_API_BASE_URL=https://mediassist-3jpl.onrender.com

# Comma-separated user_id values (sha256(lowercased email)[:24]) that
# should see the Admin Analytics link in the sidebar. This is a UI
# convenience ONLY - it does not grant access. The real security
# boundary is the backend's ADMIN_USER_IDS check on GET
# /admin/analytics (see app/auth/admin.py). Someone not in this list
# who navigates to /admin/analytics directly still gets a clean 403
# from the backend; this just controls whether the link is shown.
VITE_ADMIN_USER_IDS=
