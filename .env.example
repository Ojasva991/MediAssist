# Copy to .env and fill in. NEVER commit .env or paste real keys in chat/zips.

APP_NAME=Vaeda AI
ENVIRONMENT=development        # set to "production" on the host

# ---- Database: free Neon Postgres (https://neon.com). Paste the pooled
# connection string. sslmode=require is added automatically if missing.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname

# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Browser + mobile-app origins allowed to call the API (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost,https://YOUR-SITE.pages.dev

# 1 = one reverse proxy (Render/Cloud Run). Used for per-IP rate limits.
TRUSTED_PROXY_HOPS=1

# ---- AI providers: set ANY subset. The gateway tries them in this order
# and skips ones with no key. All below have a free tier (limits change -
# check each console). "local" = your own Ollama/llama.cpp server.
AI_PROVIDER_ORDER=groq,cerebras,mistral,openrouter,cloudflare,local,gemini

GROQ_API_KEY=                  # https://console.groq.com
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

CEREBRAS_API_KEY=              # https://cloud.cerebras.ai
CEREBRAS_MODEL=llama3.1-8b

MISTRAL_API_KEY=               # https://console.mistral.ai
MISTRAL_MODEL=mistral-small-latest
MISTRAL_VISION_MODEL=mistral-small-latest

OPENROUTER_API_KEY=            # https://openrouter.ai  (":free" models)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

CLOUDFLARE_ACCOUNT_ID=         # Workers AI free daily allowance
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

LOCAL_LLM_BASE_URL=            # e.g. http://localhost:11434/v1 (Ollama)
LOCAL_LLM_MODEL=               # e.g. llama3.1:8b
LOCAL_LLM_VISION_MODEL=        # e.g. llava / llama3.2-vision (optional)

GEMINI_API_KEY=                # optional now
GEMINI_MODEL=gemini-2.5-flash
